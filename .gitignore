# MeepleOS .gitignore

# Environment & Secrets (NEVER COMMIT)
.env
.env.*
!.env.example
*.pem
*.key
*.pfx

# Microsoft Office temporary / lock files
~$*.docx
~$*.pptx
~$*.xlsx
*.tmp

# Python / Research
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/

# .NET / C# / ASP.NET Core
bin/
obj/
[Bb]in/
[Oo]bj/
[Tt]est[Rr]esults/
*.suo
*.user
*.userosscache
*.sln.docstates
appsettings*.Development.json
appsettings*.Production.json

# Node / Frontend / React
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.next/
out/
.parcel-cache/
.cache/

# IDEs & Editors
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.swp
*.swo
*~

# Operating System
Thumbs.db
[Dd]esktop.ini
.DS_Store
*.stackdump

# Logs & Diagnostics
*.log
logs/
